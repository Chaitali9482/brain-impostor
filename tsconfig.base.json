{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@brain-impostor/source"],
    "paths": {
      "@brain-impostor/types": ["libs/types/src/index.ts"],
      "@brain-impostor/data": ["libs/data/src/index.ts"],
      "@brain-impostor/game": ["libs/game/src/index.ts"],
      "@brain-impostor/ui": ["libs/ui/src/index.ts"]
    }
  }
}
